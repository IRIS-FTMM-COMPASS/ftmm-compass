# Base URL backend API untuk frontend.
# Kosongkan bila backend berjalan lokal (request /api lewat proxy Vite).
# Isi bila memakai Cloudflare Tunnel atau backend remote:
# - Base URL saja: https://<subdomain>.trycloudflare.com
VITE_API_BASE=

# Blok akun demo di halaman login. Aktif otomatis saat `pnpm dev`;
# set `false` untuk menyembunyikannya (wajib di environment production).
VITE_DEV_ACCOUNT_PICKER=
